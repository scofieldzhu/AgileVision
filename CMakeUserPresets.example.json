{
  "version": 6,
  "configurePresets": [
    {
      "name": "local-vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "X_VCPKG_APPLOCAL_DEPS_INSTALL": "ON"
      }
    },
    {
      "name": "vs2022-local",
      "inherits": [
        "vs2022",
        "local-vcpkg"
      ],
      "binaryDir": "${sourceDir}/build/vs2022-local",
      "installDir": "${sourceDir}/install"
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug-local",
      "configurePreset": "vs2022-local",
      "configuration": "Debug"
    },
    {
      "name": "build-release-local",
      "configurePreset": "vs2022-local",
      "configuration": "Release"
    }
  ]
}
